{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>brig-id/.github"],
  "packageRules": [
    {
      "description": "The server and the interface are only tested against here: ci, like a server elsewhere.",
      "matchPackageNames": ["brig-id/server-seedling", "brig-id/app"],
      "semanticCommitType": "ci",
      "commitMessageAction": "👷 test against"
    }
  ]
}
